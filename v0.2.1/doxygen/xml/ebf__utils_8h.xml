    <sectiondef kind="func">
      <memberdef kind="function" id="ebf__utils_8h_1a215ccc192f06529b13aa06e1ec2378f1" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>uint8_t</type>
        <definition>uint8_t EBF_utils_log2</definition>
        <argsstring>(uint8_t byte)</argsstring>
        <name>EBF_utils_log2</name>
        <param>
          <type>uint8_t</type>
          <declname>byte</declname>
        </param>
        <briefdescription>
<para>Returns the position of the most significant set bit in a byte. </para>
        </briefdescription>
        <detaileddescription>
<para>Returns the 1-based index of the most significant bit set in the input byte. If <computeroutput>byte</computeroutput> is fully clear, the function returns 0.</para>
<para>The default weak implementation is software-only (lookup table + shifts). On cores/ports that provide a hardware-specific instruction (e.g., CLZ in ARM), this function can be overridden for improved performance.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">byte</parametername>
</parameternamelist>
<parameterdescription>
<para>input byte. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Position (1–8) of highest set bit, or 0 if no bits are set. </para>
</simplesect>
</para>
        </detaileddescription>
