      </memberdef>
      <memberdef kind="function" id="edf__hsm_8c_1a523554bcc30e074f0666138a3c6ecb6b" prot="public" static="yes" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>static void EDF_hsm_executeTransition</definition>
        <argsstring>(EDF_hsm_t *me, EDF_hsm_stateHandler_t *e_path, int_fast8_t e_idx, EDF_hsm_stateHandler_t *x_path, int_fast8_t x_idx)</argsstring>
        <name>EDF_hsm_executeTransition</name>
        <param>
          <type><ref refid="structEDF__hsm__t" kindref="compound">EDF_hsm_t</ref> *</type>
          <declname>me</declname>
        </param>
        <param>
          <type><ref refid="edf__hsm_8h_1af3baec581532a1e7dff79290016046cd" kindref="member">EDF_hsm_stateHandler_t</ref> *</type>
          <declname>e_path</declname>
        </param>
        <param>
          <type>int_fast8_t</type>
          <declname>e_idx</declname>
        </param>
        <param>
          <type><ref refid="edf__hsm_8h_1af3baec581532a1e7dff79290016046cd" kindref="member">EDF_hsm_stateHandler_t</ref> *</type>
          <declname>x_path</declname>
        </param>
        <param>
          <type>int_fast8_t</type>
          <declname>x_idx</declname>
        </param>
        <briefdescription>
<para>Executes transition along the given entry and exit paths in the HSM. </para>
        </briefdescription>
        <detaileddescription>
<para>Performs the exit actions for all states in <computeroutput>x_path</computeroutput>, then the entry actions for all states in <computeroutput>e_path</computeroutput>. Handles initial transitions recursively if the target state defines them, updating the current active state accordingly.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="inout">me</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the HSM instance. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">e_path</parametername>
</parameternamelist>
<parameterdescription>
<para>Ordered list of states to enter, from target upward. The array must be at least EDF_HSM_MAX_DEPTH in size. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">e_idx</parametername>
</parameternamelist>
<parameterdescription>
<para>Last valid index in <computeroutput>e_path</computeroutput> (−1 if no entry actions). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">x_path</parametername>
</parameternamelist>
<parameterdescription>
<para>Ordered list of states to exit, from source upward. The array must be at least EDF_HSM_MAX_DEPTH in size. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">x_idx</parametername>
</parameternamelist>
<parameterdescription>
<para>Last valid index in <computeroutput>x_path</computeroutput> (−1 if no exit actions). </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
