      <memberdef kind="function" id="edf__pool_8c_1ad7480419c24fe94d4008bd9fc2387e61" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void EDF_pool_init</definition>
        <argsstring>(void *pool_storage, uint_fast32_t pool_size, EDF_pool_blockSize_t block_size)</argsstring>
        <name>EDF_pool_init</name>
        <param>
          <type>void *</type>
          <declname>pool_storage</declname>
        </param>
        <param>
          <type>uint_fast32_t</type>
          <declname>pool_size</declname>
        </param>
        <param>
          <type>EDF_pool_blockSize_t</type>
          <declname>block_size</declname>
        </param>
        <briefdescription>
<para>Initializes a pool. </para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="note"><para>Proper memory alignment of the pool storage is required to ensure safe pointer access. As described in <ref refid="/workspaces/embedded_workbench/sw/ecf/event_driven_framework/src/framework/src/edf_pool.c_1free_list" kindref="member">free_list</ref>, the first bytes of each block store a pointer to the next free block; if the storage is not properly aligned, this may lead to undefined behavior or hardware faults on some architectures. It is recommended to use <ref refid="emf__utils_8h_1a187facb8161d36f1bed711ae44ec731a" kindref="member">EMF_UTILS_MEM_ALIGNED_SLOT</ref> or an equivalent alignment-safe definition. This not only guarantees correct pointer alignment, but also ensures that the computed number of blocks matches the ratio of pool_size to block_size as intended.</para>
</simplesect>
<xrefsect id="todo_1_todo000022"><xreftitle>Todo</xreftitle><xrefdescription><para>Currently, pools must be initialized in ascending block size order. Future implementations shall allow pools to be initialized in any order.</para>
</xrefdescription></xrefsect></para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">pool_storage</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the storage for the pool. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">pool_size</parametername>
</parameternamelist>
<parameterdescription>
<para>Total size of pool_storage in bytes. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">block_size</parametername>
</parameternamelist>
<parameterdescription>
<para>Size of each block of the pool in bytes. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
<para>Dynamic range check. Only needed when EDF_pool_blockCnt_t is 8 or 16 bits; for 32-bit, n_total always fits.</para>
        </inbodydescription>
