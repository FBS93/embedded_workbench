      <memberdef kind="define" id="emf__utils_8h_1a187facb8161d36f1bed711ae44ec731a" prot="public" static="no">
        <name>EMF_UTILS_MEM_ALIGNED_SLOT</name>
        <param><defname>size</defname></param>
        <initializer>  struct                                                          \
  {                                                               \
    void* storage[((size) + sizeof(void*) - 1U) / sizeof(void*)]; \
  }</initializer>
        <briefdescription>
<para>Defines a portable, memory-aligned slot. </para>
        </briefdescription>
        <detaileddescription>
<para>This macro defines a struct containing an array of <computeroutput>void*</computeroutput> large enough to hold a memory slot of the specified <computeroutput>size</computeroutput>.</para>
<para><programlisting><codeline><highlight class="normal">//<sp/>Example:<sp/>Define<sp/>a<sp/>slot<sp/>for<sp/>a<sp/>custom<sp/>structure</highlight></codeline>
<codeline><highlight class="normal">EMF_UTILS_MEM_ALIGNED_SLOT(sizeof(myStruct_t))<sp/>mySlot;</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">//<sp/>Example:<sp/>Array<sp/>of<sp/>10<sp/>aligned<sp/>slots</highlight></codeline>
<codeline><highlight class="normal">EMF_UTILS_MEM_ALIGNED_SLOT(sizeof(myStruct_t))<sp/>myStorage[10];</highlight></codeline>
</programlisting></para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">size</parametername>
</parameternamelist>
<parameterdescription>
<para>Requested slot size in bytes. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
