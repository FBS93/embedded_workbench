    <sectiondef kind="func">
      <memberdef kind="function" id="emf__print_8h_1aa2affc0918cda6aaf259b4492d973f86" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void EMF_print</definition>
        <argsstring>(const char *fmt, const uintptr_t *args)</argsstring>
        <name>EMF_print</name>
        <param>
          <type>const char *</type>
          <declname>fmt</declname>
        </param>
        <param>
          <type>const uintptr_t *</type>
          <declname>args</declname>
        </param>
        <briefdescription>
<para>Print a formatted message with arguments. </para>
        </briefdescription>
        <detaileddescription>
<para>Function used by EMF_PRINT macro.</para>
<para>The complete message is written atomically through EBF stdout. EAF is triggered if the formatted message exceeds <computeroutput>EMF_PRINT_MAX_LEN</computeroutput> or EBF stdout rejects the write.</para>
<para><simplesect kind="note"><para>This function shall not be called from an active EBF critical section. See <ref refid="/workspaces/embedded_workbench/sw/ecf/embedded_middleware_framework/src/emf_print/inc/emf_print.h_1emf_stdout_critical_section_precondition" kindref="member">emf_stdout_critical_section_precondition</ref>.</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">fmt</parametername>
</parameternamelist>
<parameterdescription>
<para>Null-terminated format string. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">args</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to array of arguments, or NULL. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
<para>&lt; Floating-point representation.</para>
