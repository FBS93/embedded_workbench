        <type>void</type>
        <definition>void EMF_cobs_encode</definition>
        <argsstring>(const uint8_t *buff_in, uint16_t len_in, uint8_t *buff_out, uint16_t *len_out)</argsstring>
        <name>EMF_cobs_encode</name>
        <param>
          <type>const uint8_t *</type>
          <declname>buff_in</declname>
        </param>
        <param>
          <type>uint16_t</type>
          <declname>len_in</declname>
        </param>
        <param>
          <type>uint8_t *</type>
          <declname>buff_out</declname>
        </param>
        <param>
          <type>uint16_t *</type>
          <declname>len_out</declname>
        </param>
        <briefdescription>
<para>COBS encode data to buffer. </para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="note"><para>The output includes a trailing EMF_COBS_PACKET_DELIMITER.</para>
</simplesect>
<simplesect kind="note"><para>The input and output buffers must not overlap.</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">buff_in</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to input data to encode </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">len_in</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of bytes to encode </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">buff_out</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to encoded output buffer. The output buffer must be at least len_in + (len_in / EMF_COBS_BLOCK_MAX) + 2 bytes to accommodate worst-case COBS expansion. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">len_out</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to a variable that will be set to the encoded length. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
