      <memberdef kind="function" id="emf__cobs_8c_1aa69189e6dafbfd6bbcaf04250ef73bb6" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>bool</type>
        <definition>bool EMF_cobs_decode</definition>
        <argsstring>(const uint8_t *buff_in, uint16_t len_in, uint8_t *buff_out, uint16_t *len_out)</argsstring>
        <name>EMF_cobs_decode</name>
        <param>
          <type>const uint8_t *</type>
          <declname>buff_in</declname>
        </param>
        <param>
          <type>uint16_t</type>
          <declname>len_in</declname>
        </param>
        <param>
          <type>uint8_t *</type>
          <declname>buff_out</declname>
        </param>
        <param>
          <type>uint16_t *</type>
          <declname>len_out</declname>
        </param>
        <briefdescription>
<para>Decodes a COBS‑encoded buffer. </para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="note"><para>Decoding stops when a EMF_COBS_PACKET_DELIMITER is encountered, or when len_in bytes have been processed.</para>
</simplesect>
<simplesect kind="note"><para>The minimum size required for the buff_out size is: len_in - 2 bytes. This is because, in the best case, COBS encoding only adds one byte for the length code and one byte for the final EMF_COBS_PACKET_DELIMITER.</para>
</simplesect>
<simplesect kind="note"><para>The input and output buffers must not overlap.</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">buff_in</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the COBS‑encoded input buffer. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">len_in</parametername>
</parameternamelist>
<parameterdescription>
<para>Length of the input buffer, in bytes. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">buff_out</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the buffer to receive decoded data. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">len_out</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to a variable that will be set to the decoded length. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>true if a COBS packet delimiter (EMF_COBS_PACKET_DELIMITER) was found, so the output is valid. false otherwise. </para>
</simplesect>
</para>
        </detaileddescription>
